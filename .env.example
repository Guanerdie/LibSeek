API_PORT=8000
FRONTEND_PORT=9527

# 默认使用 Compose 持久卷中的 SQLite；留空即可。
DATABASE_URL=

# 普通本机首次打开页面时创建管理员。已有部署也可继续提供以下三项。
AUTH_LOCAL_USERNAME=
AUTH_LOCAL_PASSWORD=
AUTH_SESSION_SIGNING_KEY=
AUTH_LOCAL_ROLE=admin
AUTH_COOKIE_SECURE=false

# 四类连接都可在“设置”页面保存。以下变量仅用于环境注入部署。
NEXTFIND_BASE_URL=https://nextfind.example
NEXTFIND_ALLOWED_HOSTS=nextfind.example
NEXTFIND_USERNAME=
NEXTFIND_PASSWORD=

TMDB_BASE_URL=https://api.themoviedb.org
TMDB_ACCESS_TOKEN=

# 可选；仅代理 NextFind、TMDB 和 PT 站点的外部 HTTP 请求。
OUTBOUND_PROXY_URL=
OUTBOUND_PROXY_USERNAME=
OUTBOUND_PROXY_PASSWORD=

AVISTAZ_BASE_URL=https://avistaz.to
AVISTAZ_USERNAME=
AVISTAZ_PASSWORD=
AVISTAZ_PID=

QB_BASE_URL=
QB_USERNAME=
QB_PASSWORD=
QB_ALLOWED_HOSTS=
QB_ALLOW_INSECURE_HTTP=false
QB_TARGET_SAVE_PATH=
QB_TARGET_CATEGORY=
QB_PLAN_TAGS=

# 唯一保留的外部写入授权。设为 true 后，已登录 operator 可将选中资源提交到 qB。
ENABLE_QB_WRITE=false

MAX_CANDIDATE_SIZE_BYTES=
TORRENT_MAX_BYTES=10485760
TORRENT_MAX_FILES=20000
