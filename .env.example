# 复制为 .env 后再修改。此文件只含示例占位值，不得提交真实凭据。
POSTGRES_DB=unin
POSTGRES_USER=unin
POSTGRES_PASSWORD=change-me-before-production
DATABASE_URL=postgresql+psycopg://unin:change-me-before-production@postgres:5432/unin

API_PORT=8000
FRONTEND_PORT=8080

# 本地单账号认证。三个敏感值留空；生产部署优先使用 Docker Secret override。
# 任一项缺失、签名密钥少于 32 个字符或 Secret 文件不可读时，受保护 API 默认拒绝访问。
AUTH_LOCAL_USERNAME=
AUTH_LOCAL_PASSWORD=
AUTH_SESSION_SIGNING_KEY=
# viewer 仅查看；operator 可执行一般状态变更；admin 还可批准和撤销审批。
AUTH_LOCAL_ROLE=admin
AUTH_SESSION_TTL_SECONDS=28800
AUTH_BOOTSTRAP_CSRF_TTL_SECONDS=600
# 仅 HTTPS 部署设为 true；本机 HTTP 调试保持 false，否则浏览器不会发送 Secure Cookie。
AUTH_COOKIE_SECURE=false

# NextFind 只读账号。留空时系统可启动，但禁止创建发现任务。
NEXTFIND_BASE_URL=https://nextfind.example
NEXTFIND_USERNAME=
NEXTFIND_PASSWORD=
ALLOWED_EXTERNAL_HOSTS=nextfind.example,api.themoviedb.org,avistaz.to

# 第二阶段真实只读连接默认关闭。优先使用 deploy/compose.secrets.yaml.example，禁止提交真实值。
ENABLE_TMDB_LIVE=false
TMDB_BASE_URL=https://api.themoviedb.org
TMDB_ACCESS_TOKEN=
TMDB_MIN_INTERVAL_SECONDS=0.25
TMDB_CACHE_TTL_SECONDS=86400
TMDB_CACHE_MAX_ENTRIES=512
TMDB_ALLOW_FUTURE_EPISODES=false

ENABLE_AVISTAZ_LIVE_SEARCH=false
AVISTAZ_BASE_URL=https://avistaz.to
AVISTAZ_USERNAME=
AVISTAZ_PASSWORD=
AVISTAZ_PID=
AVISTAZ_MIN_INTERVAL_SECONDS=6

EXTERNAL_CONNECT_TIMEOUT_SECONDS=5
EXTERNAL_READ_TIMEOUT_SECONDS=30
EXTERNAL_MAX_RESPONSE_BYTES=10485760

# Worker 任务租约。续租间隔必须小于租约时长。
WORKER_POLL_SECONDS=2
WORKER_HEARTBEAT_STALE_SECONDS=30
JOB_MAX_ATTEMPTS=3
JOB_LEASE_SECONDS=300
JOB_LEASE_RENEW_INTERVAL_SECONDS=60

# 第三阶段 qBittorrent 只读连接默认关闭。URL、用户名和密码优先使用 Docker Secret。
ENABLE_QB_READ_ONLY=false
QB_BASE_URL=
QB_USERNAME=
QB_PASSWORD=
QB_ALLOWED_HOSTS=
# 只有明确接受受信内网明文 HTTP 风险时才设为 true；默认要求 HTTPS。
QB_ALLOW_INSECURE_HTTP=false

# 下载计划策略。目标真实路径只用于后端预检，计划和 API 仅保存 QB_SAVE_PATH_REF。
QB_TARGET_CATEGORY=
QB_TARGET_SAVE_PATH=
QB_SAVE_PATH_REF=qb-default-save-path
QB_ALLOWED_SAVE_PATHS=
QB_PLAN_TAGS=
QB_TARGET_INSTANCE_REF=qb-primary

# 阶段 4 仅允许创建数据库执行记录；不会访问 AvistaZ 下载地址或调用 qB 写接口。
ENABLE_DOWNLOAD_EXECUTION_CONTROL_PLANE=false
EXECUTION_INTENT_DEFAULT_TTL_SECONDS=300
EXECUTION_INTENT_MAX_TTL_SECONDS=900
MAX_CANDIDATE_SIZE_BYTES=

# 阶段 5 独立下载执行器。只有以下三个开关全部为 true 才允许启动；默认全部关闭。
# 启用意味着会访问 AvistaZ download URL 并可能向 qBittorrent 添加任务。
ENABLE_DOWNLOAD_EXECUTOR=false
ENABLE_AVISTAZ_TORRENT_FETCH=false
ENABLE_QB_WRITE=false
DOWNLOAD_EXECUTION_LEASE_SECONDS=300
DOWNLOAD_EXECUTION_LEASE_RENEW_INTERVAL_SECONDS=60
DOWNLOAD_EXECUTION_RETRY_BASE_SECONDS=30
DOWNLOAD_EXECUTION_RETRY_MAX_SECONDS=900
DOWNLOAD_EXECUTOR_POLL_SECONDS=2
TORRENT_MAX_BYTES=10485760
TORRENT_MAX_FILES=20000

# 独立监控器只读取 qB；必须同时启用 ENABLE_QB_READ_ONLY，且不会执行暂停、恢复或删除。
ENABLE_DOWNLOAD_MONITOR=false
DOWNLOAD_MONITOR_INTERVAL_SECONDS=15
DOWNLOAD_MONITOR_BATCH_SIZE=100

# 逗号分隔，支持 shell 通配符，例如 4.3.*,5.0.0。未配置时预检为 UNKNOWN。
AVISTAZ_FORBIDDEN_QB_VERSIONS=
APPROVAL_DEFAULT_TTL_MINUTES=60
APPROVAL_MAX_TTL_MINUTES=10080
APPROVAL_PREFLIGHT_MAX_AGE_SECONDS=300
