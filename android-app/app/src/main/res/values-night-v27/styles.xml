<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.UNIN" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/unin_background_night</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/unin_background_night</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">@color/unin_cyan</item>
    </style>

    <style name="Theme.UNIN.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/unin_background_night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_unin_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.UNIN</item>
    </style>
</resources>
