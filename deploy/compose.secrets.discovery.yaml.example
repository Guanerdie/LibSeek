# 第一阶段只读发现 Secret override：本地认证 3 个、NextFind 2 个、TMDB 1 个。
# 本 Secret 层只要求这 6 个文件；不会声明或挂载 AvistaZ/qBittorrent Secret。
# 显式空字符串确保多 override 叠加时也会清除主 Compose 已插值的同名明文值。
services:
  api:
    environment:
      AUTH_LOCAL_USERNAME: ""
      AUTH_LOCAL_PASSWORD: ""
      AUTH_SESSION_SIGNING_KEY: ""
      NEXTFIND_USERNAME: ""
      NEXTFIND_PASSWORD: ""
      TMDB_ACCESS_TOKEN: ""
      AUTH_LOCAL_USERNAME_FILE: /run/secrets/auth_local_username
      AUTH_LOCAL_PASSWORD_FILE: /run/secrets/auth_local_password
      AUTH_SESSION_SIGNING_KEY_FILE: /run/secrets/auth_session_signing_key
      NEXTFIND_USERNAME_FILE: /run/secrets/nextfind_username
      NEXTFIND_PASSWORD_FILE: /run/secrets/nextfind_password
      TMDB_ACCESS_TOKEN_FILE: /run/secrets/tmdb_access_token
    secrets:
      - auth_local_username
      - auth_local_password
      - auth_session_signing_key
      - nextfind_username
      - nextfind_password
      - tmdb_access_token
  worker:
    environment:
      NEXTFIND_USERNAME: ""
      NEXTFIND_PASSWORD: ""
      TMDB_ACCESS_TOKEN: ""
      NEXTFIND_USERNAME_FILE: /run/secrets/nextfind_username
      NEXTFIND_PASSWORD_FILE: /run/secrets/nextfind_password
      TMDB_ACCESS_TOKEN_FILE: /run/secrets/tmdb_access_token
    secrets:
      - nextfind_username
      - nextfind_password
      - tmdb_access_token

secrets:
  auth_local_username:
    file: ./secrets/auth_local_username.txt
  auth_local_password:
    file: ./secrets/auth_local_password.txt
  auth_session_signing_key:
    file: ./secrets/auth_session_signing_key.txt
  nextfind_username:
    file: ./secrets/nextfind_username.txt
  nextfind_password:
    file: ./secrets/nextfind_password.txt
  tmdb_access_token:
    file: ./secrets/tmdb_access_token.txt
