# qBittorrent Secret 增量 override。仅在获准访问目标 qB 实例后叠加。
# 不声明其他 Secret，也不会自行开启只读、自动预检、写入或监控开关/profile。
# 显式空字符串确保多 override 叠加时也会清除主 Compose 已插值的同名明文值。
services:
  api:
    environment:
      QB_BASE_URL: ""
      QB_USERNAME: ""
      QB_PASSWORD: ""
      QB_BASE_URL_FILE: /run/secrets/qb_base_url
      QB_USERNAME_FILE: /run/secrets/qb_username
      QB_PASSWORD_FILE: /run/secrets/qb_password
    secrets:
      - qb_base_url
      - qb_username
      - qb_password
  automation-preflight:
    environment:
      QB_BASE_URL: ""
      QB_USERNAME: ""
      QB_PASSWORD: ""
      QB_BASE_URL_FILE: /run/secrets/qb_base_url
      QB_USERNAME_FILE: /run/secrets/qb_username
      QB_PASSWORD_FILE: /run/secrets/qb_password
    secrets:
      - qb_base_url
      - qb_username
      - qb_password
  download-executor:
    environment:
      QB_BASE_URL: ""
      QB_USERNAME: ""
      QB_PASSWORD: ""
      QB_BASE_URL_FILE: /run/secrets/qb_base_url
      QB_USERNAME_FILE: /run/secrets/qb_username
      QB_PASSWORD_FILE: /run/secrets/qb_password
    secrets:
      - qb_base_url
      - qb_username
      - qb_password
  download-monitor:
    environment:
      QB_BASE_URL: ""
      QB_USERNAME: ""
      QB_PASSWORD: ""
      QB_BASE_URL_FILE: /run/secrets/qb_base_url
      QB_USERNAME_FILE: /run/secrets/qb_username
      QB_PASSWORD_FILE: /run/secrets/qb_password
    secrets:
      - qb_base_url
      - qb_username
      - qb_password

secrets:
  qb_base_url:
    file: ./secrets/qb_base_url.txt
  qb_username:
    file: ./secrets/qb_username.txt
  qb_password:
    file: ./secrets/qb_password.txt
