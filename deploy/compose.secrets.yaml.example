# 运行时 Secret override。需要 secrets/README.md 中列出的 12 个本地文件。
# Secret 按最小权限挂载；普通 Worker 和 frontend 不可读取 qBittorrent Secret。
services:
  api:
    environment:
      AUTH_LOCAL_USERNAME: !reset null
      AUTH_LOCAL_PASSWORD: !reset null
      AUTH_SESSION_SIGNING_KEY: !reset null
      NEXTFIND_USERNAME: !reset null
      NEXTFIND_PASSWORD: !reset null
      TMDB_ACCESS_TOKEN: !reset null
      AVISTAZ_USERNAME: !reset null
      AVISTAZ_PASSWORD: !reset null
      AVISTAZ_PID: !reset null
      QB_BASE_URL: !reset null
      QB_USERNAME: !reset null
      QB_PASSWORD: !reset null
      AUTH_LOCAL_USERNAME_FILE: /run/secrets/auth_local_username
      AUTH_LOCAL_PASSWORD_FILE: /run/secrets/auth_local_password
      AUTH_SESSION_SIGNING_KEY_FILE: /run/secrets/auth_session_signing_key
      NEXTFIND_USERNAME_FILE: /run/secrets/nextfind_username
      NEXTFIND_PASSWORD_FILE: /run/secrets/nextfind_password
      TMDB_ACCESS_TOKEN_FILE: /run/secrets/tmdb_access_token
      AVISTAZ_USERNAME_FILE: /run/secrets/avistaz_username
      AVISTAZ_PASSWORD_FILE: /run/secrets/avistaz_password
      AVISTAZ_PID_FILE: /run/secrets/avistaz_pid
      QB_BASE_URL_FILE: /run/secrets/qb_base_url
      QB_USERNAME_FILE: /run/secrets/qb_username
      QB_PASSWORD_FILE: /run/secrets/qb_password
    secrets:
      - auth_local_username
      - auth_local_password
      - auth_session_signing_key
      - nextfind_username
      - nextfind_password
      - tmdb_access_token
      - avistaz_username
      - avistaz_password
      - avistaz_pid
      - qb_base_url
      - qb_username
      - qb_password
  worker:
    # Worker 只执行 TMDB/AvistaZ 外部任务，不接收 qBittorrent Secret。
    environment:
      NEXTFIND_USERNAME: !reset null
      NEXTFIND_PASSWORD: !reset null
      TMDB_ACCESS_TOKEN: !reset null
      AVISTAZ_USERNAME: !reset null
      AVISTAZ_PASSWORD: !reset null
      AVISTAZ_PID: !reset null
      NEXTFIND_USERNAME_FILE: /run/secrets/nextfind_username
      NEXTFIND_PASSWORD_FILE: /run/secrets/nextfind_password
      TMDB_ACCESS_TOKEN_FILE: /run/secrets/tmdb_access_token
      AVISTAZ_USERNAME_FILE: /run/secrets/avistaz_username
      AVISTAZ_PASSWORD_FILE: /run/secrets/avistaz_password
      AVISTAZ_PID_FILE: /run/secrets/avistaz_pid
    secrets:
      - nextfind_username
      - nextfind_password
      - tmdb_access_token
      - avistaz_username
      - avistaz_password
      - avistaz_pid
  automation-preflight:
    environment:
      QB_BASE_URL: !reset null
      QB_USERNAME: !reset null
      QB_PASSWORD: !reset null
      QB_BASE_URL_FILE: /run/secrets/qb_base_url
      QB_USERNAME_FILE: /run/secrets/qb_username
      QB_PASSWORD_FILE: /run/secrets/qb_password
    secrets:
      - qb_base_url
      - qb_username
      - qb_password
  download-executor:
    environment:
      AVISTAZ_USERNAME: !reset null
      AVISTAZ_PASSWORD: !reset null
      AVISTAZ_PID: !reset null
      QB_BASE_URL: !reset null
      QB_USERNAME: !reset null
      QB_PASSWORD: !reset null
      AVISTAZ_USERNAME_FILE: /run/secrets/avistaz_username
      AVISTAZ_PASSWORD_FILE: /run/secrets/avistaz_password
      AVISTAZ_PID_FILE: /run/secrets/avistaz_pid
      QB_BASE_URL_FILE: /run/secrets/qb_base_url
      QB_USERNAME_FILE: /run/secrets/qb_username
      QB_PASSWORD_FILE: /run/secrets/qb_password
    secrets:
      - avistaz_username
      - avistaz_password
      - avistaz_pid
      - qb_base_url
      - qb_username
      - qb_password
  download-monitor:
    environment:
      QB_BASE_URL: !reset null
      QB_USERNAME: !reset null
      QB_PASSWORD: !reset null
      QB_BASE_URL_FILE: /run/secrets/qb_base_url
      QB_USERNAME_FILE: /run/secrets/qb_username
      QB_PASSWORD_FILE: /run/secrets/qb_password
    secrets:
      - qb_base_url
      - qb_username
      - qb_password

secrets:
  auth_local_username:
    file: ./secrets/auth_local_username.txt
  auth_local_password:
    file: ./secrets/auth_local_password.txt
  auth_session_signing_key:
    file: ./secrets/auth_session_signing_key.txt
  nextfind_username:
    file: ./secrets/nextfind_username.txt
  nextfind_password:
    file: ./secrets/nextfind_password.txt
  tmdb_access_token:
    file: ./secrets/tmdb_access_token.txt
  avistaz_username:
    file: ./secrets/avistaz_username.txt
  avistaz_password:
    file: ./secrets/avistaz_password.txt
  avistaz_pid:
    file: ./secrets/avistaz_pid.txt
  qb_base_url:
    file: ./secrets/qb_base_url.txt
  qb_username:
    file: ./secrets/qb_username.txt
  qb_password:
    file: ./secrets/qb_password.txt
