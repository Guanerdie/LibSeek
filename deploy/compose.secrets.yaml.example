# 运行时 Secret override。需要 secrets/README.md 中列出的 7 个本地文件。
# qBittorrent 三个 Secret 只挂载给 API；Worker 和 frontend 不可见。
services:
  api:
    environment:
      TMDB_ACCESS_TOKEN: null
      AVISTAZ_USERNAME: null
      AVISTAZ_PASSWORD: null
      AVISTAZ_PID: null
      QB_BASE_URL: null
      QB_USERNAME: null
      QB_PASSWORD: null
      TMDB_ACCESS_TOKEN_FILE: /run/secrets/tmdb_access_token
      AVISTAZ_USERNAME_FILE: /run/secrets/avistaz_username
      AVISTAZ_PASSWORD_FILE: /run/secrets/avistaz_password
      AVISTAZ_PID_FILE: /run/secrets/avistaz_pid
      QB_BASE_URL_FILE: /run/secrets/qb_base_url
      QB_USERNAME_FILE: /run/secrets/qb_username
      QB_PASSWORD_FILE: /run/secrets/qb_password
    secrets:
      - tmdb_access_token
      - avistaz_username
      - avistaz_password
      - avistaz_pid
      - qb_base_url
      - qb_username
      - qb_password
  worker:
    # Worker 只执行 TMDB/AvistaZ 外部任务，不接收 qBittorrent Secret。
    environment:
      TMDB_ACCESS_TOKEN: null
      AVISTAZ_USERNAME: null
      AVISTAZ_PASSWORD: null
      AVISTAZ_PID: null
      TMDB_ACCESS_TOKEN_FILE: /run/secrets/tmdb_access_token
      AVISTAZ_USERNAME_FILE: /run/secrets/avistaz_username
      AVISTAZ_PASSWORD_FILE: /run/secrets/avistaz_password
      AVISTAZ_PID_FILE: /run/secrets/avistaz_pid
    secrets:
      - tmdb_access_token
      - avistaz_username
      - avistaz_password
      - avistaz_pid

secrets:
  tmdb_access_token:
    file: ./secrets/tmdb_access_token.txt
  avistaz_username:
    file: ./secrets/avistaz_username.txt
  avistaz_password:
    file: ./secrets/avistaz_password.txt
  avistaz_pid:
    file: ./secrets/avistaz_pid.txt
  qb_base_url:
    file: ./secrets/qb_base_url.txt
  qb_username:
    file: ./secrets/qb_username.txt
  qb_password:
    file: ./secrets/qb_password.txt
