# AvistaZ Secret 增量 override。仅在获准访问 AvistaZ 后叠加。
# 不声明认证、NextFind、TMDB 或 qBittorrent Secret，也不会自行开启任何实时开关。
# 显式空字符串确保多 override 叠加时也会清除主 Compose 已插值的同名明文值。
services:
  api:
    environment:
      AVISTAZ_USERNAME: ""
      AVISTAZ_PASSWORD: ""
      AVISTAZ_PID: ""
      AVISTAZ_USERNAME_FILE: /run/secrets/avistaz_username
      AVISTAZ_PASSWORD_FILE: /run/secrets/avistaz_password
      AVISTAZ_PID_FILE: /run/secrets/avistaz_pid
    secrets:
      - avistaz_username
      - avistaz_password
      - avistaz_pid
  worker:
    environment:
      AVISTAZ_USERNAME: ""
      AVISTAZ_PASSWORD: ""
      AVISTAZ_PID: ""
      AVISTAZ_USERNAME_FILE: /run/secrets/avistaz_username
      AVISTAZ_PASSWORD_FILE: /run/secrets/avistaz_password
      AVISTAZ_PID_FILE: /run/secrets/avistaz_pid
    secrets:
      - avistaz_username
      - avistaz_password
      - avistaz_pid
  download-executor:
    environment:
      AVISTAZ_USERNAME: ""
      AVISTAZ_PASSWORD: ""
      AVISTAZ_PID: ""
      AVISTAZ_USERNAME_FILE: /run/secrets/avistaz_username
      AVISTAZ_PASSWORD_FILE: /run/secrets/avistaz_password
      AVISTAZ_PID_FILE: /run/secrets/avistaz_pid
    secrets:
      - avistaz_username
      - avistaz_password
      - avistaz_pid

secrets:
  avistaz_username:
    file: ./secrets/avistaz_username.txt
  avistaz_password:
    file: ./secrets/avistaz_password.txt
  avistaz_pid:
    file: ./secrets/avistaz_pid.txt
