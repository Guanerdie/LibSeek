# 统一换行符，避免 CRLF/LF 抖动把真实改动淹没
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
gradlew.bat text eol=crlf

# 二进制文件不做换行处理
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.jar binary
*.keystore binary
*.jks binary
*.torrent binary
